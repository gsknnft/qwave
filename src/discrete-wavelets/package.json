{
  "name": "discrete-wavelets",
  "version": "5.0.15",
  "description": "A Discrete Wavelet Transform (DWT) library for the web.",
  "keywords": [
    "discrete",
    "wavelet",
    "transform",
    "signal processing",
    "data",
    "analysis",
    "scientific"
  ],
  "typings": "dist/lib/wt.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Simon Hochholzer <simon@symmetronic.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Symmetronic/discrete-wavelets"
  },
  "bugs": {
    "url": "https://github.com/Symmetronic/discrete-wavelets/issues"
  },
  "homepage": "https://symmetronic.github.io/discrete-wavelets/",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node -e \"require('node:fs').rmSync('docs',{recursive:true,force:true})\" && node -e \"require('node:fs').rmSync('tsconfig.tsbuildinfo',{recursive:true,force:true})\" && node -e \"require('node:fs').rmSync('*.tsbuildinfo',{recursive:true,force:true})\"",
    "build:declarations": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:docs": "typedoc --out docs src/wt.ts",
    "build": "pnpm clean && vite build && pnpm build:declarations",
    "test": "vitest run",
    "test:prod": "pnpm run lint && pnpm run test",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.2.1",
    "eslint-plugin-react": "^7.37.5",
    "rimraf": "^6.1.2",
    "typedoc": "^0.28.14",
    "typescript": "^6.0.3",
    "vite": "7.2.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jest": "^30.2.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@octokit/request-error": "^7.1.0",
    "dev": "^0.1.3",
    "pino": "^10.1.0",
    "snowflake-sdk": "^2.3.1"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/lib/index.d.ts"
}
