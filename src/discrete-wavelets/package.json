{
  "name": "discrete-wavelets",
  "version": "5.0.15",
  "description": "A Discrete Wavelet Transform (DWT) library for the web.",
  "keywords": [
    "discrete",
    "wavelet",
    "transform",
    "signal processing",
    "data",
    "analysis",
    "scientific"
  ],
  "main": "dist/discrete-wavelets.umd.js",
  "module": "dist/discrete-wavelets.es5.js",
  "typings": "dist/lib/wt.d.ts",
  "files": [
    "dist"
  ],
  "author": "Simon Hochholzer <simon@symmetronic.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Symmetronic/discrete-wavelets"
  },
  "bugs": {
    "url": "https://github.com/Symmetronic/discrete-wavelets/issues"
  },
  "homepage": "https://symmetronic.github.io/discrete-wavelets/",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.23.0"
  },
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist docs",
    "build:declarations": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:docs": "typedoc --out docs src/wt.ts",
    "build": "pnpm clean && vite build && tsc -p tsconfig.json && pnpm build:declarations && pnpm build:umd && pnpm build:docs",
    "start": "rollup -c rollup.config.ts -w",
    "build:umd": "rollup -c rollup.config.mjs",
    "test": "jest --coverage",
    "test:prod": "pnpm run lint && pnpm run test -- --no-cache",
    "test:watch": "jest --coverage --watch",
    "prepublishOnly": "pnpm run build"
  },

  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-typescript": "12.1.4",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/pluginutils": "^4.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.2.1",
    "eslint-plugin-react": "^7.37.5",
    "lodash.camelcase": "^4.3.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vite": "7.2.7"
  },
  "dependencies": {
    "jest": "^30.2.0",
    "@types/lodash.camelcase": "^4.3.9",
    "@octokit/request-error": "^7.1.0",
    "dev": "^0.1.3",
    "pino": "^10.1.0",
    "snowflake-sdk": "^2.3.1"
  }
  
}
